                <p id="hook-text-${vidId}" style="font-size:14px; margin:0; color:#e2e8f0; line-height:1.5; background:#0f172a; padding:12px; border-radius:8px; border:1px solid #334155;">${escapeHTML(hooks.patternInterrupt)}</p>
                
                <input type="hidden" id="hook-data-patternInterrupt-${vidId}" value="${escapeHTML(hooks.patternInterrupt)}">
                <input type="hidden" id="hook-data-curiosityGap-${vidId}" value="${escapeHTML(hooks.curiosityGap)}">
                <input type="hidden" id="hook-data-painPoint-${vidId}" value="${escapeHTML(hooks.painPoint)}">
                <input type="hidden" id="hook-data-valueFirst-${vidId}" value="${escapeHTML(hooks.valueFirst)}">
              </div>

              <!-- KEYWORD BADGES -->
              <div style="background:#1e293b; padding:14px; border-radius:12px;">
                <strong style="color:#94a3b8; font-size:11px; display:block; margin-bottom:8px; text-transform:uppercase;">Spoken & On-Screen Keyword Badges</strong>
                <div>${spokenPills} ${overlayPills}</div>
              </div>

              <!-- HASHTAG MATRIX -->
              <div style="background:#1e293b; padding:14px; border-radius:12px; border-left:4px solid #38bdf8;">
                <strong style="color:#38bdf8; font-size:11px; letter-spacing:0.8px; display:block; margin-bottom:6px; text-transform:uppercase;">3x3 HASHTAG MATRIX</strong>
                <p id="tags-${vidId}" style="font-size:13px; color:#cbd5e1; margin:0; line-height:1.4;">${escapeHTML(allTags)}</p>
              </div>

              <!-- RE-ANALYZE CONTROL -->
              <div style="display:flex; gap:8px;">
                <input type="text" id="niche-${vidId}" placeholder="Keyword / Niche Target" style="flex:1;">
                <select id="tone-${vidId}" style="width:130px;">
                  <option value="High Energy">High Energy</option>
                  <option value="Storytelling">Storytelling</option>
                  <option value="Controversial">Controversial</option>
                  <option value="Educational">Educational</option>
                </select>
                <button data-vid="${vidId}" data-title="${titleEsc}" onclick="reAnalyze(this)" class="btn-outline-neon">Re-Run AI</button>
              </div>

              <!-- ACTIONS -->
              <div style="display:flex; gap:10px; margin-top:8px;">
                <button data-vid="${vidId}" onclick="copyMasterPayload(this)" class="btn-secondary" style="flex:1; padding:12px;">Copy Full Payload</button>
                <button data-vid="${vidId}" data-title="${titleEsc}" onclick="openScheduleModalFromStudio('${vidId}', '${titleEsc}')" class="btn-neon" style="flex:1; padding:12px; text-align:center;">Schedule Post</button>
              </div>

            </div>
          </div>
        </div>
      </div>
    `;
  }).join("");

  return page(`
    <!-- NAVBAR WITH WORKING PROFILE DROPDOWN MENU -->
    <nav style="display:flex; justify-content:space-between; align-items:center; padding:16px 32px; background:#0f172a; border-bottom:1px solid rgba(0, 240, 255, 0.2); position:relative; z-index:1000;">
      <div style="display:flex; align-items:center; gap:24px;">
        <span style="font-weight:900; font-size:22px; color:#00f0ff; letter-spacing:1.5px; text-shadow: 0 0 15px rgba(0, 240, 255, 0.4);">VYNT AI</span>
        <a href="/" style="color:#94a3b8; font-size:13px; font-weight:600;">Main Page</a>
        <button onclick="startDashboardTour()" class="btn-outline-neon" style="padding:4px 10px; font-size:11px;">🚀 Guided Tour</button>
      </div>
      
      <!-- PROFILE MENU WRAPPER -->
      <div style="position:relative;" id="profileWrapper">
        <div id="profileBtn" onclick="toggleProfileMenu(event)" style="display:flex; align-items:center; gap:10px; background: rgba(30, 41, 59, 0.8); padding: 6px 14px 6px 8px; border-radius: 30px; border: 1px solid #00f0ff; cursor:pointer; user-select:none; box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);" class="tour-profile-btn">
          ${avatarUrl ? `<img src="${escapeHTML(avatarUrl)}" style="width:32px; height:32px; border-radius:50%; border:2px solid #00f0ff; object-fit:cover;" alt="Avatar">` : `<div style="width:32px; height:32px; border-radius:50%; background:#00f0ff;"></div>`}
          <span style="font-weight:700; font-size:13px; color:#f8fafc;">${displayName}</span>
          <span style="font-size:10px; color:#00f0ff;">▼</span>
        </div>

        <!-- DROPDOWN MENU CONTAINER -->
        <div id="dropdownMenu" style="display:none; position:absolute; right:0; top:50px; width:260px; background:#0f172a; border:1px solid #00f0ff; border-radius:14px; padding:10px 0; box-shadow: 0 10px 40px rgba(0, 240, 255, 0.3); z-index:9999; backdrop-filter:blur(12px);">
          <div style="padding:10px 16px; border-bottom:1px solid #1e293b;">
            <span style="display:block; font-size:11px; color:#94a3b8; text-transform:uppercase; letter-spacing:0.5px;">Account Connected</span>
            <span style="font-weight:700; font-size:13px; color:#00f0ff;">🟢 ${displayName}</span>
          </div>

          <div onclick="openQueueModal()" class="dropdown-item">📅 Scheduled Queue Manager</div>
          <div onclick="startDashboardTour()" class="dropdown-item">🚀 Interactive Dashboard Tour</div>
          <a href="/oauth/tiktok" class="dropdown-item">🔄 Switch / Reconnect TikTok</a>
          <div onclick="exportCSV()" class="dropdown-item">📥 Export SEO Matrix (CSV)</div>

          <div style="border-top:1px solid #1e293b; margin-top:6px; padding-top:6px;">
            <a href="/oauth/tiktok" class="dropdown-item" style="color:#ef4444;">🚪 Disconnect Account</a>
          </div>
        </div>
      </div>
    </nav>

    <div style="max-width:1200px; margin:0 auto; padding: 30px 20px;">
      <div style="text-align:center; margin-bottom:30px;">
        <h1 style="font-size:30px; font-weight:800; color:#fff; margin:0 0 8px 0;">TikTok Creator Feed</h1>
        <p style="color:#94a3b8; font-size:14px; margin:0;">Select any video thumbnail below to launch its full AI SEO Optimization Studio</p>
      </div>
      
      <div style="display:flex; gap:12px; justify-content:center; margin-bottom:30px;">
        <input type="text" id="search" placeholder="Search TikTok videos..." onkeyup="filterCards()" style="width:300px;">
        <button onclick="exportCSV()" class="btn-secondary" style="padding:10px 18px;">Export CSV</button>
      </div>

      <!-- TIKTOK STYLE GRID -->
      <div class="tiktok-grid" id="videoGrid">
        ${tiktokGridCards}
      </div>
    </div>

    <!-- VIDEO STUDIO MODALS -->
    ${videoStudioModals}

    <!-- SCHEDULE POST MODAL -->
    <div id="scheduleModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(8, 13, 26, 0.85); backdrop-filter: blur(8px); justify-content:center; align-items:center; z-index:3000;">
      <div style="background:#0f172a; border:1px solid #00f0ff; width:90%; max-width:480px; padding:30px; border-radius:20px; text-align:left; box-shadow: 0 0 40px rgba(0, 240, 255, 0.25);">
        <h2 style="margin-top:0; color:#00f0ff; font-size:22px; font-weight:800;">Schedule Auto-Post</h2>
        <input type="hidden" id="schedVidId">
        <input type="hidden" id="schedOpenId" value="${escapeHTML(openId)}">
        
        <label style="font-size:12px; font-weight:600; color:#94a3b8; display:block; margin-bottom:6px;">Video Title</label>
        <input type="text" id="schedTitle" style="width:100%; margin-bottom:14px;">

        <label style="font-size:12px; font-weight:600; color:#94a3b8; display:block; margin-bottom:6px;">Caption (Chosen Hook)</label>
        <textarea id="schedCaption" rows="3" style="width:100%; margin-bottom:14px;"></textarea>

        <label style="font-size:12px; font-weight:600; color:#94a3b8; display:block; margin-bottom:6px;">Hashtags</label>
        <input type="text" id="schedHashtags" style="width:100%; margin-bottom:14px;">

        <label style="font-size:12px; font-weight:600; color:#94a3b8; display:block; margin-bottom:6px;">Schedule Date & Time</label>
        <input type="datetime-local" id="schedTime" style="width:100%; margin-bottom:24px; color-scheme:dark;">

        <div style="display:flex; gap:12px; justify-content:flex-end;">
          <button onclick="closeScheduleModal()" class="btn-secondary">Cancel</button>
          <button onclick="submitSchedule()" class="btn-neon">Confirm Schedule</button>
        </div>
      </div>
    </div>

    <!-- SCHEDULED QUEUE MANAGER MODAL -->
    <div id="queueModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(8, 13, 26, 0.85); backdrop-filter: blur(8px); justify-content:center; align-items:center; z-index:3000;">
      <div style="background:#0f172a; border:1px solid #00f0ff; width:90%; max-width:650px; padding:30px; border-radius:20px; text-align:left; max-height:80vh; overflow-y:auto; box-shadow: 0 0 40px rgba(0, 240, 255, 0.25);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
          <h2 style="margin:0; color:#00f0ff; font-size:22px; font-weight:800;">📅 Scheduled Posts Queue (D1)</h2>
          <button onclick="closeQueueModal()" class="btn-secondary">Close</button>
        </div>
        <div id="queueListContent">Loading queue...</div>
      </div>
    </div>

    <!-- GUIDED TOUR MODAL -->
    <div id="tourModal" style="display:none; position:fixed; bottom:30px; right:30px; width:340px; background:#0f172a; border:2px solid #00f0ff; border-radius:16px; padding:20px; z-index:4000; box-shadow: 0 10px 40px rgba(0,240,255,0.4);">
      <h4 id="tourTitle" style="margin:0 0 8px 0; color:#00f0ff; font-size:16px;">Tour Step</h4>
      <p id="tourBody" style="font-size:13px; color:#cbd5e1; margin:0 0 16px 0; line-height:1.4;"></p>
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <span id="tourStepIndicator" style="font-size:11px; color:#94a3b8;">Step 1 of 3</span>
        <div>
          <button onclick="endTour()" class="btn-secondary" style="padding:4px 8px; font-size:11px; margin-right:4px;">Skip</button>
          <button onclick="nextTourStep()" class="btn-neon" style="padding:4px 12px; font-size:11px;">Next ➔</button>
        </div>
      </div>
    </div>

    <script>
      // DROPDOWN MENU HANDLER
      function toggleProfileMenu(e) {
        if (e) e.stopPropagation();
        const menu = document.getElementById("dropdownMenu");
        if (menu) {
          menu.style.display = (menu.style.display === "none" || menu.style.display === "") ? "block" : "none";
        }
      }

      document.addEventListener("click", function(e) {
        const menu = document.getElementById("dropdownMenu");
        const wrapper = document.getElementById("profileWrapper");
        if (menu && wrapper && !wrapper.contains(e.target)) {
          menu.style.display = "none";
        }
      });

      // SEO STUDIO MODAL HANDLERS
      function openSEOStudio(vidId) {
        const studio = document.getElementById("studio-modal-" + vidId);
        if (studio) studio.style.display = "block";
      }

      function closeSEOStudio(vidId) {
        const studio = document.getElementById("studio-modal-" + vidId);
        if (studio) studio.style.display = "none";
      }

      function switchHook(btn, vidId, hookKey) {
        const parent = btn.parentElement;
        parent.querySelectorAll(".hook-tab").forEach(t => t.classList.remove("active"));
        btn.classList.add("active");

        const hookVal = document.getElementById("hook-data-" + hookKey + "-" + vidId).value;
        document.getElementById("hook-text-" + vidId).innerText = hookVal;
      }

      function copyActiveHook(btn) {
        const vidId = btn.dataset.vid;
        const text = document.getElementById("hook-text-" + vidId).innerText;
        navigator.clipboard.writeText(text);
        alert("Hook copied to clipboard!");
      }

      function copyMasterPayload(btn) {
        const vidId = btn.dataset.vid;
        const title = document.getElementById("studio-title-" + vidId).innerText;
        const hook = document.getElementById("hook-text-" + vidId).innerText;
        const tags = document.getElementById("tags-" + vidId).innerText;
        
        const payload = title + "\\n\\n" + hook + "\\n\\n" + tags;
        navigator.clipboard.writeText(payload);
        alert("Master payload copied (Title + Hook + Hashtags)!");
      }

      async function openQueueModal() {
        document.getElementById("dropdownMenu").style.display = "none";
        document.getElementById("queueModal").style.display = "flex";
        const content = document.getElementById("queueListContent");
        content.innerHTML = '<p style="color:#aaa;">Fetching scheduled queue from D1...</p>';
        
        try {
          const res = await fetch("/api/scheduled-posts");
          const data = await res.json();
          if (!data.posts || data.posts.length === 0) {
            content.innerHTML = '<p style="color:#94a3b8;">No scheduled posts found in queue.</p>';
            return;
          }

          let html = '<div style="display:flex; flex-direction:column; gap:12px;">';
          data.posts.forEach(p => {
            const statusColor = p.status === 'published' ? '#10b981' : '#00f0ff';
            html += \`
              <div style="background:#1e293b; padding:12px; border-radius:10px; border-left:3px solid \${statusColor}">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                  <strong style="color:#fff; font-size:14px;">\${p.video_title || 'Untitled'}</strong>
                  <span style="color:\${statusColor}; font-size:11px; font-weight:bold; text-transform:uppercase;">\${p.status}</span>
                </div>
                <p style="margin:0 0 6px 0; font-size:12px; color:#cbd5e1;">"\${p.chosen_caption}"</p>
                <span style="font-size:11px; color:#94a3b8;">🕒 Scheduled for: \${new Date(p.scheduled_time).toLocaleString()}</span>
              </div>
            \`;
          });
          html += '</div>';
          content.innerHTML = html;
        } catch(e) {
          content.innerHTML = '<p style="color:#ef4444;">Failed to load queue.</p>';
        }
      }

      function closeQueueModal() {
        document.getElementById("queueModal").style.display = "none";
      }

      function filterCards() {
        const q = document.getElementById("search").value.toLowerCase();
        document.querySelectorAll(".tiktok-card").forEach(c => {
          const t = c.querySelector(".tiktok-card-title").innerText.toLowerCase();
          c.style.display = t.includes(q) ? "block" : "none";
        });
      }

      function exportCSV() {
        document.getElementById("dropdownMenu").style.display = "none";
        const rows = [["Title", "Active Hook"]];
        document.querySelectorAll(".studio-modal").forEach(c => {
          const vidId = c.id.replace("studio-modal-", "");
          const title = document.getElementById("studio-title-" + vidId) ? document.getElementById("studio-title-" + vidId).innerText : "";
          const hook = document.getElementById("hook-text-" + vidId) ? document.getElementById("hook-text-" + vidId).innerText : "";
          rows.push(['"' + title.replace(/"/g, '""') + '"', '"' + hook.replace(/"/g, '""') + '"']);
        });
        const csvContent = rows.map(r => r.join(",")).join("\\n");
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "vynt_seo_report.csv";
        a.click();
      }

      async function reAnalyze(btn) {
        const vid = btn.dataset.vid;
        const title = btn.dataset.title;
        const nicheEl = document.getElementById("niche-" + vid);
        const toneEl = document.getElementById("tone-" + vid);
        const niche = nicheEl ? nicheEl.value : "";
        const tone = toneEl ? toneEl.value : "High Energy";

        const res = await fetch("/api/reanalyze", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ video: { title }, niche, tone })
        });
        const data = await res.json();
        if (data.hooks) {
          document.getElementById("hook-data-patternInterrupt-" + vid).value = data.hooks.patternInterrupt || "";
          document.getElementById("hook-data-curiosityGap-" + vid).value = data.hooks.curiosityGap || "";
          document.getElementById("hook-data-painPoint-" + vid).value = data.hooks.painPoint || "";
          document.getElementById("hook-data-valueFirst-" + vid).value = data.hooks.valueFirst || "";

          document.getElementById("hook-text-" + vid).innerText = data.hooks.patternInterrupt || "Re-analyzed!";
          alert("AI re-analyzed post with tone [" + tone + "] for niche: " + (niche || "General"));
        }
      }

      function openScheduleModalFromStudio(vidId, title) {
        const hookText = document.getElementById("hook-text-" + vidId) ? document.getElementById("hook-text-" + vidId).innerText : "";
        const tagsText = document.getElementById("tags-" + vidId) ? document.getElementById("tags-" + vidId).innerText : "";

        document.getElementById("schedVidId").value = vidId;
        document.getElementById("schedTitle").value = title;
        document.getElementById("schedCaption").value = hookText;
        document.getElementById("schedHashtags").value = tagsText;

        const now = new Date();
        now.setHours(now.getHours() + 1);
        document.getElementById("schedTime").value = now.toISOString().slice(0,16);

        document.getElementById("scheduleModal").style.display = "flex";
      }

      function closeScheduleModal() {
        document.getElementById("scheduleModal").style.display = "none";
      }

      async function submitSchedule() {
        const openId = document.getElementById("schedOpenId").value;
        const title = document.getElementById("schedTitle").value;
        const caption = document.getElementById("schedCaption").value;
        const hashtags = document.getElementById("schedHashtags").value;
        const scheduledTime = document.getElementById("schedTime").value;

        if (!scheduledTime) {
          alert("Please pick a valid date and time.");
          return;
        }

        const res = await fetch("/api/schedule", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ openId, title, caption, hashtags, scheduledTime })
        });

        const data = await res.json();
        if (data.success) {
          alert(data.message);
          closeScheduleModal();
        } else {
          alert("Error scheduling post: " + (data.error || "Unknown error"));
        }
      }

      // GUIDED DASHBOARD TOUR SCRIPT
      let tourStep = 0;
      const tourSteps = [
        {
          target: ".tour-video-card",
          title: "1. TikTok Video Feed",
          body: "Click on any video card in this TikTok-style grid layout to open its dedicated AI SEO Studio."
        },
        {
          target: ".tour-profile-btn",
          title: "2. Working Profile Dropdown",
          body: "Click your profile picture to access your account status, scheduled post queue, CSV export, and reconnection controls."
        }
      ];

      function startDashboardTour() {
        document.getElementById("dropdownMenu").style.display = "none";
        tourStep = 0;
        document.getElementById("tourModal").style.display = "block";
        showTourStep();
      }

      function showTourStep() {
        document.querySelectorAll(".tour-highlight").forEach(e => e.classList.remove("tour-highlight"));
        const current = tourSteps[tourStep];
        document.getElementById("tourTitle").innerText = current.title;
        document.getElementById("tourBody").innerText = current.body;
        document.getElementById("tourStepIndicator").innerText = "Step " + (tourStep + 1) + " of " + tourSteps.length;

        const el = document.querySelector(current.target);
        if (el) el.classList.add("tour-highlight");
      }

      function nextTourStep() {
        tourStep++;
        if (tourStep >= tourSteps.length) {
          endTour();
        } else {
          showTourStep();
        }
      }

      function endTour() {
        document.querySelectorAll(".tour-highlight").forEach(e => e.classList.remove("tour-highlight"));
        document.getElementById("tourModal").style.display = "none";
      }
    </script>
  `);
}

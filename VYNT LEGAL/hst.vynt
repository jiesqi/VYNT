const CLIENT_KEY = "awh7kq529gyf37d2";

const TIKTOK_AUTHORIZE =
  "https://www.tiktok.com/v2/auth/authorize/";

const TIKTOK_TOKEN =
  "https://open.tiktokapis.com/v2/oauth/token/";

const TIKTOK_API =
  "https://open.tiktokapis.com/v2";

const SCOPES =
  "user.info.basic,video.list";

export default {
  async fetch(request, env) {

    const url = new URL(request.url);

    // TikTok redirects back to this Worker automatically
    const REDIRECT_URI =
      `${url.origin}/oauth/callback`;

    // -------------------------
    // CONNECT TIKTOK
    // -------------------------

    if (url.pathname === "/oauth/tiktok") {

      const state = crypto.randomUUID();

      const auth =
        new URL(TIKTOK_AUTHORIZE);

      auth.searchParams.set(
        "client_key",
        CLIENT_KEY
      );

      auth.searchParams.set(
        "response_type",
        "code"
      );

      auth.searchParams.set(
        "scope",
        SCOPES
      );

      auth.searchParams.set(
        "redirect_uri",
        REDIRECT_URI
      );

      auth.searchParams.set(
        "state",
        state
      );

      return new Response(null, {
        status: 302,

        headers: {
          "Location": auth.toString(),

          "Set-Cookie":
            `vynt_tiktok_state=${state}; Max-Age=600; Path=/; HttpOnly; Secure; SameSite=Lax`
        }
      });
    }

    // -------------------------
    // TIKTOK CALLBACK
    // -------------------------

    if (url.pathname === "/oauth/callback") {

      const code =
        url.searchParams.get("code");

      const state =
        url.searchParams.get("state");

      const error =
        url.searchParams.get("error");

      if (error) {
        return page(`
          <h1>TikTok Authorization Failed</h1>
          <p>${escapeHTML(error)}</p>
        `, 400);
      }

      if (!code || !state) {
        return page(`
          <h1>Missing authorization data</h1>
        `, 400);
      }

      // Check OAuth state
      const cookies =
        parseCookies(
          request.headers.get("Cookie")
        );

      if (
        cookies.vynt_tiktok_state !== state
      ) {
        return page(`
          <h1>Invalid OAuth State</h1>
          <p>Please try connecting again.</p>
        `, 403);
      }

      if (!env.TIKTOK_CLIENT_SECRET) {
        return page(`
          <h1>VYNT Configuration Error</h1>
          <p>TIKTOK_CLIENT_SECRET is missing.</p>
        `, 500);
      }

      // -------------------------
      // EXCHANGE CODE FOR TOKEN
      // -------------------------

      const tokenResponse =
        await fetch(
          TIKTOK_TOKEN,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
              new URLSearchParams({
                client_key:
                  CLIENT_KEY,

                client_secret:
                  env.TIKTOK_CLIENT_SECRET,

                code:
                  code,

                grant_type:
                  "authorization_code",

                redirect_uri:
                  REDIRECT_URI
              })
          }
        );

      const token =
        await tokenResponse.json();

      if (
        !tokenResponse.ok ||
        !token.access_token
      ) {
        return page(`
          <h1>TikTok Token Error</h1>

          <pre>${escapeHTML(
            JSON.stringify(
              token,
              null,
              2
            )
          )}</pre>
        `, 500);
      }

      // -------------------------
      // GET TIKTOK PROFILE
      // -------------------------

      const profileResponse =
        await fetch(
          `${TIKTOK_API}/user/info/?fields=open_id,display_name,avatar_url,profile_deep_link`,
          {
            headers: {
              Authorization:
                `Bearer ${token.access_token}`
            }
          }
        );

      const profile =
        await profileResponse.json();

      const user =
        profile.data?.user;

      if (!user) {
        return page(`
          <h1>✓ TikTok Connected</h1>

          <p>
            TikTok authorization succeeded,
            but profile information was not returned.
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `);
      }

      // -------------------------
      // SUCCESS
      // -------------------------

      return page(`

        ${
          user.avatar_url
            ? `
              <img
                class="avatar"
                src="${escapeHTML(
                  user.avatar_url
                )}"
                alt="TikTok profile"
              >
            `
            : ""
        }

        <h1>✓ TikTok Connected</h1>

        <h2>
          ${escapeHTML(
            user.display_name ||
            "TikTok User"
          )}
        </h2>

        <p>
          Your TikTok account was successfully
          connected to VYNT.
        </p>

        <p>
          Authorized scopes:
        </p>

        <code>
          ${escapeHTML(
            token.scope || SCOPES
          )}
        </code>

        <br><br>

        <a href="https://dev.vynttechnologies.workers.dev/">
          Return to VYNT
        </a>

      `);
    }

    // -------------------------
    // WORKER TEST
    // -------------------------

    return new Response(
      "VYNT TikTok OAuth Worker is running."
    );
  }
};


// =================================
// COOKIE PARSER
// =================================

function parseCookies(header) {

  const cookies = {};

  if (!header) {
    return cookies;
  }

  for (
    const part of header.split(";")
  ) {

    const [
      key,
      ...value
    ] =
      part.trim().split("=");

    if (key) {
      cookies[key] =
        value.join("=");
    }
  }

  return cookies;
}


// =================================
// HTML PAGE
// =================================

function page(content, status = 200) {

  return new Response(`

<!DOCTYPE html>

<html>

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

<title>VYNT — TikTok</title>

<style>

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #08090c;
  color: white;
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  text-align: center;
  padding: 20px;
}

.box {
  width: 100%;
  max-width: 600px;
  padding: 40px;
  background: #101217;
  border: 1px solid #24272e;
  border-radius: 18px;
}

.avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
}

a {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 20px;
  background: white;
  color: black;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 700;
}

pre {
  text-align: left;
  overflow: auto;
}

code {
  color: #aaa;
}

</style>

</head>

<body>

<div class="box">

${content}

</div>

</body>

</html>

`, {
    status,

    headers: {
      "Content-Type":
        "text/html;charset=UTF-8"
    }
  });
}


// =================================
// HTML ESCAPE
// =================================

function escapeHTML(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}
    </div>

    <!-- SCHEDULE MODAL -->
    <div id="scheduleModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); justify-content:center; align-items:center; z-index:999;">
      <div style="background:#101217; border:1px solid #333; width:90%; max-width:480px; padding:25px; border-radius:12px; text-align:left;">
        <h2 style="margin-top:0; color:#70e000;">Schedule Post</h2>

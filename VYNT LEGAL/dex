const CLIENT_KEY = "sbawcke2l51k5b54vw";
const TIKTOK_AUTHORIZE = "https://www.tiktok.com/v2/auth/authorize/";
const TIKTOK_TOKEN = "https://open.tiktokapis.com/v2/oauth/token/";
const TIKTOK_API = "https://open.tiktokapis.com/v2";
const SCOPES = "user.info.basic,video.list";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const REDIRECT_URI = `${url.origin}/oauth/callback`;

    // 1. RE-ANALYZE API ENDPOINT
    if (url.pathname === "/api/reanalyze" && request.method === "POST") {
      try {
        const { video, niche, tone } = await request.json();
        const updatedSEO = await generateFullSEO(env, video || {}, niche, tone);
        return new Response(JSON.stringify(updatedSEO), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
      }
    }

    // 2. SCHEDULE POST API ENDPOINT
    if (url.pathname === "/api/schedule" && request.method === "POST") {
      try {
        const { openId, accessToken, title, caption, hashtags, scheduledTime } = await request.json();
        if (env.DB) {
          await env.DB.prepare(
            `INSERT INTO scheduled_posts (id, open_id, access_token, video_title, chosen_caption, chosen_hashtags, scheduled_time)
             VALUES (?, ?, ?, ?, ?, ?, ?)`
          ).bind(
            crypto.randomUUID(), openId, accessToken || "sandbox", title, caption, hashtags, scheduledTime
          ).run();
        }

        return new Response(JSON.stringify({ success: true, message: "Queued for TikTok automation!" }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (err) {
        return new Response(JSON.stringify({ error: err.message }), { status: 500 });
      }
    }

    // 3. START OAUTH FLOW
    if (url.pathname === "/oauth/tiktok") {
      const state = crypto.randomUUID();
      const auth = new URL(TIKTOK_AUTHORIZE);
      auth.searchParams.set("client_key", CLIENT_KEY);
      auth.searchParams.set("response_type", "code");
      auth.searchParams.set("scope", SCOPES);
      auth.searchParams.set("redirect_uri", REDIRECT_URI);
      auth.searchParams.set("state", state);

      return new Response(null, {
        status: 302,
        headers: {
          "Location": auth.toString(),
          "Set-Cookie": `vynt_tiktok_state=${state}; Max-Age=600; Path=/; HttpOnly; Secure; SameSite=Lax`
        }
      });
    }

    // 4. OAUTH CALLBACK & DASHBOARD
    if (url.pathname === "/oauth/callback") {
      const code = url.searchParams.get("code");
      const state = url.searchParams.get("state");
      const error = url.searchParams.get("error");
      const errorDescription = url.searchParams.get("error_description");

      if (error) return page(`<h1>TikTok Auth Failed</h1><p>${escapeHTML(errorDescription || error)}</p>`, 400);
      if (!code || !state) return page(`<h1>Missing Auth Data</h1>`, 400);

      const cookies = parseCookies(request.headers.get("Cookie"));
      if (cookies.vynt_tiktok_state !== state) return page(`<h1>Invalid State Cookie</h1>`, 403);

      // TOKEN EXCHANGE
      const tokenResponse = await fetch(TIKTOK_TOKEN, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          client_key: CLIENT_KEY,
          client_secret: env.TIKTOK_CLIENT_SECRET || "",
          code,
          grant_type: "authorization_code",
          redirect_uri: REDIRECT_URI
        })
      });

      const token = await tokenResponse.json();
      if (!tokenResponse.ok || !token.access_token) {
        return page(`<h1>Token Exchange Error</h1><pre>${escapeHTML(JSON.stringify(token, null, 2))}</pre>`, 500);
      }

      const accessToken = token.access_token;

      // GET PROFILE
      const profileUrl = new URL(`${TIKTOK_API}/user/info/`);
      profileUrl.searchParams.set("fields", "open_id,union_id,display_name,avatar_url,avatar_url_100,avatar_large_url");

      const profileRes = await fetch(profileUrl.toString(), {
        headers: { Authorization: `Bearer ${accessToken}` }
      });
      const profile = await profileRes.json();
      const user = profile.data?.user || { open_id: "creator", display_name: "TikTok Creator" };

      // GET VIDEOS
      const videoUrl = new URL(`${TIKTOK_API}/video/list/`);
      videoUrl.searchParams.set("fields", "id,title,video_description,cover_image_url,share_url,duration,create_time");

      const videosRes = await fetch(videoUrl.toString(), {
        method: "POST",
        headers: { Authorization: `Bearer ${accessToken}`, "Content-Type": "application/json" },
        body: JSON.stringify({ max_count: 10 })
      });
      const videosData = await videosRes.json();
      const videos = videosData.data?.videos || [];

      // RUN WORKERS AI ON VIDEOS
      const optimizedVideos = await Promise.all(
        videos.map(v => processVideoSEO(env, user.open_id, v))
      );

      return renderDashboardHTML(user, optimizedVideos);
    }

    return new Response("VYNT TikTok Worker active.");
  },

  // CRON TRIGGER HANDLER FOR AUTOMATED POSTING
  async scheduled(event, env, ctx) {
    if (!env.DB) return;
    const now = new Date().toISOString();
    try {
      const pendingPosts = await env.DB.prepare(
        "SELECT * FROM scheduled_posts WHERE status = 'pending' AND scheduled_time <= ?"
      ).bind(now).all();

      for (const post of (pendingPosts.results || [])) {
        await env.DB.prepare("UPDATE scheduled_posts SET status = 'published' WHERE id = ?").bind(post.id).run();
      }
    } catch (e) {
      console.error("Cron Execution Error:", e);
    }
  }
};

// WORKERS AI & D1 LOGIC
async function processVideoSEO(env, openId, video) {
  if (env.DB) {
    try {
      const cached = await env.DB.prepare(
        "SELECT seo_score, hooks, hashtags, keywords FROM user_seo WHERE open_id = ? AND video_id = ?"
      ).bind(openId, video.id).first();

      if (cached) {
        return {
          ...video,
          ai_seo: {
            score: cached.seo_score,
            hooks: JSON.parse(cached.hooks),
            hashtags: JSON.parse(cached.hashtags),
            keywords: JSON.parse(cached.keywords)
          }
        };
      }
    } catch (e) {}
  }

  const aiResult = await generateFullSEO(env, video);

  if (env.DB) {
    try {
      await env.DB.prepare(
        `INSERT INTO user_seo (open_id, video_id, seo_score, hooks, hashtags, keywords)
         VALUES (?, ?, ?, ?, ?, ?)
         ON CONFLICT(open_id, video_id) DO UPDATE SET seo_score=excluded.seo_score, hooks=excluded.hooks, hashtags=excluded.hashtags`
      ).bind(
        openId, video.id || "vid_1", aiResult.score,
        JSON.stringify(aiResult.hooks), JSON.stringify(aiResult.hashtags), JSON.stringify(aiResult.keywords)
      ).run();
    } catch (e) {}
  }

  return { ...video, ai_seo: aiResult };
}

async function generateFullSEO(env, video, customNiche = "", customTone = "High Energy") {
  const defaultSEO = {
    score: 88,
    hooks: {
      patternInterrupt: "Stop scrolling if you want to grow on TikTok!",
      curiosityGap: "The secret TikTok algorithm change nobody talks about...",
      painPoint: "Struggling to get views? Fix this now.",
      valueFirst: "3 instant SEO tricks to double your reach today."
    },
    keywords: {
      spokenKeywords: ["algorithm", "SEO", "reach"],
      textOverlays: ["Secret SEO Hack", "Must Watch"]
    },
    hashtags: {
      massReach: ["#TikTokSEO", "#FYP"],
      niche: ["#ContentCreatorTips", "#AlgorithmHack"],
      longTail: ["#TikTokGrowthStrategy2026", "#GetMoreViews"]
    }
  };

  if (!env.AI) return defaultSEO;

  try {
    const prompt = `Analyze this TikTok post:
Title: "${video.title || ''}"
Description: "${video.video_description || ''}"
Niche Focus: "${customNiche || 'General Audience'}"
Tone: "${customTone}"

Output ONLY a raw valid JSON object:
{
  "score": 88,
  "hooks": {
    "patternInterrupt": "Hook text",
    "curiosityGap": "Hook text",
    "painPoint": "Hook text",
    "valueFirst": "Hook text"
  },
  "keywords": {
    "spokenKeywords": ["term1", "term2"],
    "textOverlays": ["overlay1", "overlay2"]
  },
  "hashtags": {
    "massReach": ["#tag1", "#tag2"],
    "niche": ["#tag3", "#tag4"],
    "longTail": ["#tag5", "#tag6"]
  }
}`;

    const res = await env.AI.run('@cf/meta/llama-3-8b-instruct', {
      messages: [
        { role: 'system', content: 'Output strictly raw valid JSON.' },
        { role: 'user', content: prompt }
      ]
    });

    const cleaned = res.response.replace(/```json/g, '').replace(/```/g, '').trim();
    return JSON.parse(cleaned);
  } catch (e) {
    return defaultSEO;
  }
}

function parseCookies(header) {
  const cookies = {};
  if (!header) return cookies;
  for (const part of header.split(";")) {
    const [key, ...value] = part.trim().split("=");
    if (key) cookies[key] = value.join("=");
  }
  return cookies;
}

function escapeHTML(v) {
  return String(v || "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function page(content, status = 200) {
  return new Response(`<!DOCTYPE html><html><head><meta charset="UTF-8"><style>body{background:#08090c;color:#fff;font-family:sans-serif;padding:40px;text-align:center;}a{color:#70e000;}</style></head><body>${content}</body></html>`, { status, headers: { "Content-Type": "text/html;charset=UTF-8" } });
}

function renderDashboardHTML(user, videos) {
  const videoCards = (videos || []).map(v => {
    const score = v.ai_seo?.score || 88;
    const hookText = v.ai_seo?.hooks?.patternInterrupt || "Stop scrolling!";
    const mass = (v.ai_seo?.hashtags?.massReach || []).join(" ");
    const niche = (v.ai_seo?.hashtags?.niche || []).join(" ");
    const longTail = (v.ai_seo?.hashtags?.longTail || []).join(" ");
    const titleEsc = escapeHTML(v.title || "Untitled Post");

    return `
      <div class="card" style="background:#101217; border:1px solid #24272e; padding:20px; border-radius:12px;">
        <h3 class="v-title">${titleEsc}</h3>
        <p style="color:#70e000;">SEO Score: <strong>${score}/100</strong></p>
        
        <div style="background:#181b21; padding:10px; border-radius:8px; margin-bottom:10px;">
          <strong style="color:#38bdf8; font-size:12px;">HOOK ENGINE</strong>
          <p id="hook-${v.id}" style="font-size:13px; margin:5px 0;">${escapeHTML(hookText)}</p>
          <button onclick="copyTxt('${v.id}')" style="background:#24272e; color:#fff; border:none; padding:4px 8px; border-radius:4px; cursor:pointer; font-size:11px;">Copy Hook</button>
        </div>

        <div style="background:#181b21; padding:10px; border-radius:8px; margin-bottom:10px;">
          <strong style="color:#70e000; font-size:12px;">3x3 HASHTAG MATRIX</strong>
          <p style="font-size:12px; color:#aaa; margin:5px 0;">
            ${escapeHTML(mass + " " + niche + " " + longTail)}
          </p>
        </div>

        <div style="display:flex; gap:6px; margin-top:10px;">
          <input type="text" id="niche-${v.id}" placeholder="Keyword (e.g. Fitness)" style="flex:1; background:#181b21; border:1px solid #333; color:#fff; padding:6px; border-radius:4px; font-size:12px;">
          <button onclick="reAnalyze('${v.id}', '${titleEsc}')" style="background:#70e000; color:#000; border:none; padding:6px 10px; border-radius:4px; font-weight:bold; cursor:pointer; font-size:12px;">Re-Run AI</button>
        </div>
      </div>
    `;
  }).join("");

  return page(`
    <h1>VYNT AI Dashboard — ${escapeHTML(user.display_name)}</h1>
    <p style="color:#888;">Workers AI & D1 Storage Active</p>
    
    <div style="display:flex; gap:10px; justify-content:center; margin-bottom:20px;">
      <input type="text" id="search" placeholder="Search videos..." onkeyup="filterCards()" style="padding:8px; background:#181b21; border:1px solid #333; color:#fff; border-radius:6px;">
      <button onclick="exportCSV()" style="padding:8px 16px; background:#24272e; color:#fff; border:1px solid #444; border-radius:6px; cursor:pointer;">Export CSV</button>
    </div>

    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px; text-align:left;">
      ${videoCards}
    </div>

    <script>
      function copyTxt(id) {
        const el = document.getElementById("hook-" + id);
        if (el) {
          navigator.clipboard.writeText(el.innerText);
          alert("Hook copied to clipboard!");
        }
      }

      function filterCards() {
        const q = document.getElementById("search").value.toLowerCase();
        document.querySelectorAll(".card").forEach(c => {
          const t = c.querySelector(".v-title").innerText.toLowerCase();
          c.style.display = t.includes(q) ? "block" : "none";
        });
      }

      function exportCSV() {
        let csv = "Title,SEO Score,Active Hook\\n";
        document.querySelectorAll(".card").forEach(c => {
          const t = '"' + c.querySelector(".v-title").innerText.replace(/"/g, '""') + '"';
          const s = c.querySelector("strong").innerText;
          const hEl = c.querySelector("p[id^='hook-']");
          const h = hEl ? '"' + hEl.innerText.replace(/"/g, '""') + '"' : '""';
          csv += t + "," + s + "," + h + "\\n";
        });
        const blob = new Blob([csv], { type: "text/csv" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "vynt_seo_report.csv";
        a.click();
      }

      async function reAnalyze(vid, title) {
        const nicheEl = document.getElementById("niche-" + vid);
        const niche = nicheEl ? nicheEl.value : "";
        const res = await fetch("/api/reanalyze", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ video: { title }, niche, tone: "High Energy" })
        });
        const data = await res.json();
        if (data.hooks && data.hooks.patternInterrupt) {
          const hEl = document.getElementById("hook-" + vid);
          if (hEl) hEl.innerText = data.hooks.patternInterrupt;
          alert("AI re-analyzed post for niche: " + (niche || "General"));
        }
      }
    </script>
  `);
}

        <div style="display:flex; gap:6px;">
          <input type="text" id="niche-${vidId}" placeholder="Keyword (e.g. Fitness)" style="flex:1; background:#181b21; border:1px solid #333; color:#fff; padding:6px; border-radius:4px; font-size:12px;">
          <button data-vid="${vidId}" data-title="${titleEsc}" onclick="reAnalyze(this)" style="background:#24272e; color:#70e000; border:1px solid #70e000; padding:6px 10px; border-radius:4px; font-weight:bold; cursor:pointer; font-size:12px;">Re-Run AI</button>

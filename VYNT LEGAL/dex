const CLIENT_KEY = "sbawcke2l51k5b54vw";

const TIKTOK_AUTHORIZE =
  "https://www.tiktok.com/v2/auth/authorize/";

const TIKTOK_TOKEN =
  "https://open.tiktokapis.com/v2/oauth/token/";

const TIKTOK_API =
  "https://open.tiktokapis.com/v2";

const SCOPES =
  "user.info.basic,video.list";

export default {
  async fetch(request, env) {

    const url = new URL(request.url);

    const REDIRECT_URI =
      `${url.origin}/oauth/callback`;

    // =========================================
    // START TIKTOK OAUTH
    // =========================================

    if (url.pathname === "/oauth/tiktok") {

      const state = crypto.randomUUID();

      const auth =
        new URL(TIKTOK_AUTHORIZE);

      auth.searchParams.set(
        "client_key",
        CLIENT_KEY
      );

      auth.searchParams.set(
        "response_type",
        "code"
      );

      auth.searchParams.set(
        "scope",
        SCOPES
      );

      auth.searchParams.set(
        "redirect_uri",
        REDIRECT_URI
      );

      auth.searchParams.set(
        "state",
        state
      );

      return new Response(null, {
        status: 302,

        headers: {
          "Location": auth.toString(),

          "Set-Cookie":
            `vynt_tiktok_state=${state}; Max-Age=600; Path=/; HttpOnly; Secure; SameSite=Lax`
        }
      });
    }

    // =========================================
    // TIKTOK CALLBACK
    // =========================================

    if (url.pathname === "/oauth/callback") {

      const code =
        url.searchParams.get("code");

      const state =
        url.searchParams.get("state");

      const error =
        url.searchParams.get("error");

      const errorDescription =
        url.searchParams.get("error_description");

      if (error) {

        return page(`
          <h1>TikTok Authorization Failed</h1>

          <p>
            ${escapeHTML(
              errorDescription || error
            )}
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 400);
      }

      if (!code || !state) {

        return page(`
          <h1>Missing Authorization Data</h1>

          <p>
            TikTok did not return the required
            authorization information.
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 400);
      }

      // =========================================
      // CHECK OAUTH STATE
      // =========================================

      const cookies =
        parseCookies(
          request.headers.get("Cookie")
        );

      if (
        cookies.vynt_tiktok_state !== state
      ) {

        return page(`
          <h1>Invalid OAuth State</h1>

          <p>
            The security check failed.
            Please try connecting again.
          </p>
        `, 403);
      }

      // =========================================
      // CHECK SECRET
      // =========================================

      if (!env.TIKTOK_CLIENT_SECRET) {

        return page(`
          <h1>VYNT Configuration Error</h1>

          <p>
            TIKTOK_CLIENT_SECRET is missing
            from the Cloudflare Worker.
          </p>
        `, 500);
      }

      // =========================================
      // EXCHANGE CODE FOR TOKEN
      // =========================================

      const tokenResponse =
        await fetch(
          TIKTOK_TOKEN,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
              new URLSearchParams({
                client_key:
                  CLIENT_KEY,

                client_secret:
                  env.TIKTOK_CLIENT_SECRET,

                code:
                  code,

                grant_type:
                  "authorization_code",

                redirect_uri:
                  REDIRECT_URI
              })
          }
        );

      const token =
        await tokenResponse.json();

      if (
        !tokenResponse.ok ||
        !token.access_token
      ) {

        return page(`
          <h1>TikTok Token Error</h1>

          <pre>${escapeHTML(
            JSON.stringify(
              token,
              null,
              2
            )
          )}</pre>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 500);
      }

      const accessToken =
        token.access_token;

      // =========================================
      // GET USER PROFILE
      // =========================================

      const profileResponse =
        await fetch(
          `${TIKTOK_API}/user/info/?fields=open_id,display_name,avatar_url,profile_deep_link,bio_description`,
          {
            method: "GET",

            headers: {
              Authorization:
                `Bearer ${accessToken}`
            }
          }
        );

      const profile =
        await profileResponse.json();

      const user =
        profile.data?.user;

      if (!user) {

        return page(`
          <h1>TikTok Connected</h1>

          <p>
            Authorization succeeded, but TikTok
            did not return profile information.
          </p>

          <pre>${escapeHTML(
            JSON.stringify(
              profile,
              null,
              2
            )
          )}</pre>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `);
      }

      // =========================================
      // GET TIKTOK VIDEOS
      // =========================================

      const videoFields = [
        "id",
        "title",
        "video_description",
        "cover_image_url",
        "share_url",
        "duration",
        "create_time"
      ].join(",");

      const videosResponse =
        await fetch(
          `${TIKTOK_API}/video/list/?fields=${encodeURIComponent(videoFields)}`,
          {
            method: "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify({
                max_count: 20
              })
          }
        );

      const videosData =
        await videosResponse.json();

      const videos =
        videosData.data?.videos || [];

      // =========================================
      // RENDER SUCCESS PAGE
      // =========================================

      return page(`
        
        ${
          user.avatar_url
            ? `
              <img
                class="avatar"
                src="${escapeHTML(
                  user.avatar_url
                )}"
                alt="TikTok profile"
              >
            `
            : ""
        }

        <div class="success">
          ✓ TikTok Connected
        </div>

        <h1>
          ${escapeHTML(
            user.display_name ||
            "TikTok User"
          )}
        </h1>

        ${
          user.bio_description
            ? `
              <p class="bio">
                ${escapeHTML(
                  user.bio_description
                )}
              </p>
            `
            : ""
        }

        ${
          user.profile_deep_link
            ? `
              <a
                class="secondary"
                href="${escapeHTML(
                  user.profile_deep_link
                )}"
                target="_blank"
                rel="noopener"
              >
                Open TikTok Profile
              </a>
            `
            : ""
        }

        <div class="divider"></div>

        <h2>
          Your TikTok Videos
        </h2>

        <p class="muted">
          ${videos.length}
          recent public video${
            videos.length === 1
              ? ""
              : "s"
          }
          retrieved through TikTok's Display API.
        </p>

        ${
          videos.length
            ? `
              <div class="videos">

                ${videos.map(video => `
                  
                  <div class="video">

                    ${
                      video.cover_image_url
                        ? `
                          <img
                            src="${escapeHTML(
                              video.cover_image_url
                            )}"
                            alt="TikTok video thumbnail"
                            loading="lazy"
                          >
                        `
                        : ""
                    }

                    <div class="video-content">

                      <h3>
                        ${escapeHTML(
                          video.title ||
                          "Untitled TikTok Video"
                        )}
                      </h3>

                      ${
                        video.video_description
                          ? `
                            <p>
                              ${escapeHTML(
                                video.video_description
                              )}
                            </p>
                          `
                          : ""
                      }

                      ${
                        video.duration
                          ? `
                            <span class="meta">
                              ${escapeHTML(
                                String(
                                  video.duration
                                )
                              )} seconds
                            </span>
                          `
                          : ""
                      }

                      ${
                        video.create_time
                          ? `
                            <span class="meta">
                              ${formatDate(
                                video.create_time
                              )}
                            </span>
                          `
                          : ""
                      }

                      ${
                        video.share_url
                          ? `
                            <a
                              class="watch"
                              href="${escapeHTML(
                                video.share_url
                              )}"
                              target="_blank"
                              rel="noopener"
                            >
                              View on TikTok
                            </a>
                          `
                          : ""
                      }

                    </div>

                  </div>

                `).join("")}

              </div>
            `
            : `
              <div class="empty">

                <h3>
                  No public videos returned
                </h3>

                <p>
                  TikTok authorized the connection,
                  but no public videos were returned
                  for this account.
                </p>

              </div>
            `
        }

        <div class="divider"></div>

        <div class="api-status">

          <strong>
            VYNT TikTok Integration
          </strong>

          <p>
            Login Kit: Connected
          </p>

          <p>
            Profile API: Connected
          </p>

          <p>
            Display API: Connected
          </p>

          <p>
            Scope:
            ${escapeHTML(
              token.scope ||
              SCOPES
            )}
          </p>

        </div>

        <a
          class="return"
          href="https://dev.vynttechnologies.workers.dev/"
        >
          Return to VYNT
        </a>

      `);
    }

    // =========================================
    // WORKER STATUS
    // =========================================

    return new Response(
      "VYNT TikTok OAuth Worker is running."
    );
  }
};


// =============================================
// COOKIE PARSER
// =============================================

function parseCookies(header) {

  const cookies = {};

  if (!header) {
    return cookies;
  }

  for (
    const part of header.split(";")
  ) {

    const [
      key,
      ...value
    ] =
      part.trim().split("=");

    if (key) {
      cookies[key] =
        value.join("=");
    }
  }

  return cookies;
}


// =============================================
// DATE FORMATTER
// =============================================

function formatDate(timestamp) {

  try {

    const date =
      new Date(
        Number(timestamp) * 1000
      );

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "";
    }

    return date.toLocaleDateString(
      "en-US",
      {
        year: "numeric",
        month: "short",
        day: "numeric"
      }
    );

  } catch {

    return "";
  }
}



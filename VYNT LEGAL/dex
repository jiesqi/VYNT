-- 1. Store comprehensive AI SEO diagnostics
CREATE TABLE IF NOT EXISTS user_seo (
  open_id TEXT PRIMARY KEY,
  video_id TEXT,
  seo_score INTEGER,
  seo_breakdown TEXT, -- JSON string: hookStrength, indexability, cta, length
  hooks TEXT,         -- JSON string: patternInterrupt, curiosityGap, painPoint, valueFirst
  keywords TEXT,      -- JSON string: searchQueries, spokenKeywords, textOverlays
  hashtags TEXT,      -- JSON string: massReach, niche, longTail
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. Store scheduled posts for automated TikTok publishing/draft push
CREATE TABLE IF NOT EXISTS scheduled_posts (
  id TEXT PRIMARY KEY,
  open_id TEXT,
  access_token TEXT,
  video_title TEXT,
  chosen_caption TEXT,
  chosen_hashtags TEXT,
  scheduled_time DATETIME,
  status TEXT DEFAULT 'pending' -- 'pending', 'published', 'failed'
);

        <input type="hidden" id="schedOpenId" value="${escapeHTML(openId)}">
        
        <label style="font-size:12px; color:#aaa; display:block; margin-bottom:4px;">Video Title</label>
        <input type="text" id="schedTitle" style="width:100%; background:#181b21; border:1px solid #333; color:#fff; padding:8px; border-radius:6px; margin-bottom:12px; box-sizing:border-box;">

        <label style="font-size:12px; color:#aaa; display:block; margin-bottom:4px;">Caption (Hook)</label>
        <textarea id="schedCaption" rows="3" style="width:100%; background:#181b21; border:1px solid #333; color:#fff; padding:8px; border-radius:6px; margin-bottom:12px; box-sizing:border-box;"></textarea>

        <label style="font-size:12px; color:#aaa; display:block; margin-bottom:4px;">Hashtags</label>
        <input type="text" id="schedHashtags" style="width:100%; background:#181b21; border:1px solid #333; color:#fff; padding:8px; border-radius:6px; margin-bottom:12px; box-sizing:border-box;">

        <label style="font-size:12px; color:#aaa; display:block; margin-bottom:4px;">Schedule Date & Time</label>
        <input type="datetime-local" id="schedTime" style="width:100%; background:#181b21; border:1px solid #333; color:#fff; padding:8px; border-radius:6px; margin-bottom:20px; box-sizing:border-box; color-scheme:dark;">

        <div style="display:flex; gap:10px; justify-content:flex-end;">
          <button onclick="closeScheduleModal()" style="background:#24272e; color:#fff; border:1px solid #444; padding:8px 16px; border-radius:6px; cursor:pointer;">Cancel</button>
          <button onclick="submitSchedule()" style="background:#70e000; color:#000; border:none; padding:8px 16px; border-radius:6px; font-weight:bold; cursor:pointer;">Confirm Schedule</button>
        </div>
      </div>
    </div>

    <script>
      function copyTxt(btn) {
        const vid = btn.dataset.vid;
        const el = document.getElementById("hook-" + vid);
        if (el) {
          navigator.clipboard.writeText(el.innerText);
          alert("Hook copied to clipboard!");
        }
      }

      function filterCards() {
        const q = document.getElementById("search").value.toLowerCase();
        document.querySelectorAll(".card").forEach(c => {
          const t = c.querySelector(".v-title").innerText.toLowerCase();
          c.style.display = t.includes(q) ? "flex" : "none";
        });
      }

      function exportCSV() {
        const rows = [["Title", "SEO Score", "Active Hook"]];
        document.querySelectorAll(".card").forEach(c => {
          const title = c.querySelector(".v-title") ? c.querySelector(".v-title").innerText : "";
          const score = c.querySelector("span") ? c.querySelector("span").innerText : "";
          const hookEl = c.querySelector("p[id^='hook-']");
          const hook = hookEl ? hookEl.innerText : "";
          rows.push(['"' + title.replace(/"/g, '""') + '"', '"' + score.replace(/"/g, '""') + '"', '"' + hook.replace(/"/g, '""') + '"']);
        });
        const csvContent = rows.map(r => r.join(",")).join("\\n");
        const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "vynt_seo_report.csv";
        a.click();
      }

      async function reAnalyze(btn) {
        const vid = btn.dataset.vid;
        const title = btn.dataset.title;
        const nicheEl = document.getElementById("niche-" + vid);
        const niche = nicheEl ? nicheEl.value : "";
        const res = await fetch("/api/reanalyze", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ video: { title }, niche, tone: "High Energy" })
        });
        const data = await res.json();
        if (data.hooks && data.hooks.patternInterrupt) {
          const hEl = document.getElementById("hook-" + vid);
          if (hEl) hEl.innerText = data.hooks.patternInterrupt;
          alert("AI re-analyzed post for niche: " + (niche || "General"));
        }
      }

      function openScheduleModal(btn) {
        const vidId = btn.dataset.vid;
        const title = btn.dataset.title;
        const hookText = document.getElementById("hook-" + vidId) ? document.getElementById("hook-" + vidId).innerText : "";
        const tagsText = document.getElementById("tags-" + vidId) ? document.getElementById("tags-" + vidId).innerText : "";

        document.getElementById("schedVidId").value = vidId;
        document.getElementById("schedTitle").value = title;
        document.getElementById("schedCaption").value = hookText;
        document.getElementById("schedHashtags").value = tagsText;

        const now = new Date();
        now.setHours(now.getHours() + 1);
        document.getElementById("schedTime").value = now.toISOString().slice(0,16);

        document.getElementById("scheduleModal").style.display = "flex";
      }

      function closeScheduleModal() {
        document.getElementById("scheduleModal").style.display = "none";
      }

      async function submitSchedule() {
        const openId = document.getElementById("schedOpenId").value;
        const title = document.getElementById("schedTitle").value;
        const caption = document.getElementById("schedCaption").value;
        const hashtags = document.getElementById("schedHashtags").value;
        const scheduledTime = document.getElementById("schedTime").value;

        if (!scheduledTime) {
          alert("Please pick a valid date and time.");
          return;
        }

        const res = await fetch("/api/schedule", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ openId, title, caption, hashtags, scheduledTime })
        });

        const data = await res.json();
        if (data.success) {
          alert(data.message);
          closeScheduleModal();
        } else {
          alert("Error scheduling post: " + (data.error || "Unknown error"));
        }
      }
    </script>
  `);
}

        <button data-vid="${vidId}" data-title="${titleEsc}" onclick="openScheduleModal(this)" style="width:100%; background:#70e000; color:#000; border:none; padding:10px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:13px; margin-top:auto;">Schedule Auto-Post</button>
      </div>
    `;
  }).join("");

  return page(`
    <!-- TOP NAVBAR -->
    <nav style="display:flex; justify-content:space-between; align-items:center; padding:15px 30px; background:#101217; border-bottom:1px solid #24272e; margin:-30px -30px 25px -30px;">
      <div style="display:flex; align-items:center; gap:20px;">
        <span style="font-weight:bold; font-size:18px; color:#70e000; letter-spacing:1px;">VYNT AI</span>
        <a href="/" style="color:#aaa; text-decoration:none; font-size:13px;">Main Page</a>
        <a href="/oauth/tiktok" style="color:#aaa; text-decoration:none; font-size:13px;">Reconnect TikTok</a>
      </div>
      
      <div style="display:flex; align-items:center; gap:10px;">
        ${avatarUrl ? `<img src="${escapeHTML(avatarUrl)}" style="width:36px; height:36px; border-radius:50%; border:2px solid #70e000; object-fit:cover;" alt="Avatar">` : ''}
        <span style="font-weight:600; font-size:14px; color:#fff;">${displayName}</span>
      </div>
    </nav>

    <div style="max-width:1200px; margin:0 auto;">
      <h1>TikTok Creator Dashboard</h1>
      <p style="color:#888;">Workers AI, D1 Storage & TikTok Automation Active</p>
      
      <div style="display:flex; gap:10px; justify-content:center; margin-bottom:25px;">
        <input type="text" id="search" placeholder="Search videos..." onkeyup="filterCards()" style="padding:10px; background:#181b21; border:1px solid #333; color:#fff; border-radius:6px; width:250px;">
        <button onclick="exportCSV()" style="padding:10px 18px; background:#24272e; color:#fff; border:1px solid #444; border-radius:6px; cursor:pointer; font-weight:bold;">Export CSV</button>
      </div>

      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px; text-align:left;">

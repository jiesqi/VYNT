            ${shareUrl ? `<a href="${shareUrl}" target="_blank" style="color:#38bdf8; font-size:12px; text-decoration:none;">Watch on TikTok ↗</a>` : ''}
          </div>
        </div>

        <div style="background:#181b21; padding:12px; border-radius:8px;">
          <strong style="color:#38bdf8; font-size:12px; display:block; margin-bottom:4px;">HOOK ENGINE</strong>
          <p id="hook-${vidId}" style="font-size:13px; margin:0 0 8px 0;">${escapeHTML(hookText)}</p>
          <button data-vid="${vidId}" onclick="copyTxt(this)" style="background:#24272e; color:#fff; border:1px solid #444; padding:4px 8px; border-radius:4px; cursor:pointer; font-size:11px;">Copy Hook</button>
        </div>

        <div style="background:#181b21; padding:12px; border-radius:8px;">
          <strong style="color:#70e000; font-size:12px; display:block; margin-bottom:4px;">3x3 HASHTAG MATRIX</strong>
          <p id="tags-${vidId}" style="font-size:12px; color:#aaa; margin:0;">${escapeHTML(allTags)}</p>

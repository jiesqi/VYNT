const CLIENT_KEY = "sbawcke2l51k5b54vw";

const TIKTOK_AUTHORIZE =
  "https://www.tiktok.com/v2/auth/authorize/";

const TIKTOK_TOKEN =
  "https://open.tiktokapis.com/v2/oauth/token/";

const TIKTOK_API =
  "https://open.tiktokapis.com/v2";

const SCOPES =
  "user.info.basic,video.list";

export default {
  async fetch(request, env) {

    const url = new URL(request.url);

    const REDIRECT_URI =
      `${url.origin}/oauth/callback`;

    // =========================================
    // START TIKTOK OAUTH
    // =========================================

    if (url.pathname === "/oauth/tiktok") {

      const state = crypto.randomUUID();

      const auth =
        new URL(TIKTOK_AUTHORIZE);

      auth.searchParams.set(
        "client_key",
        CLIENT_KEY
      );

      auth.searchParams.set(
        "response_type",
        "code"
      );

      auth.searchParams.set(
        "scope",
        SCOPES
      );

      auth.searchParams.set(
        "redirect_uri",
        REDIRECT_URI
      );

      auth.searchParams.set(
        "state",
        state
      );

      return new Response(null, {
        status: 302,

        headers: {
          "Location": auth.toString(),

          "Set-Cookie":
            `vynt_tiktok_state=${state}; Max-Age=600; Path=/; HttpOnly; Secure; SameSite=Lax`
        }
      });
    }

    // =========================================
    // TIKTOK CALLBACK
    // =========================================

    if (url.pathname === "/oauth/callback") {

      const code =
        url.searchParams.get("code");

      const state =
        url.searchParams.get("state");

      const error =
        url.searchParams.get("error");

      const errorDescription =
        url.searchParams.get("error_description");

      if (error) {

        return page(`
          <h1>TikTok Authorization Failed</h1>

          <p>
            ${escapeHTML(
              errorDescription || error
            )}
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 400);
      }

      if (!code || !state) {

        return page(`
          <h1>Missing Authorization Data</h1>

          <p>
            TikTok did not return required information.
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 400);
      }

      // CHECK STATE COOKIE
      const cookies =
        parseCookies(
          request.headers.get("Cookie")
        );

      if (
        cookies.vynt_tiktok_state !== state
      ) {

        return page(`
          <h1>Invalid OAuth State</h1>

          <p>
            Security check failed. Try connecting again.
          </p>
        `, 403);
      }

      // CHECK SECRET
      if (!env.TIKTOK_CLIENT_SECRET) {

        return page(`
          <h1>VYNT Configuration Error</h1>

          <p>
            TIKTOK_CLIENT_SECRET is missing from Worker settings.
          </p>
        `, 500);
      }

      // EXCHANGE CODE FOR TOKEN
      const tokenResponse =
        await fetch(
          TIKTOK_TOKEN,
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/x-www-form-urlencoded"
            },

            body:
              new URLSearchParams({
                client_key:
                  CLIENT_KEY,

                client_secret:
                  env.TIKTOK_CLIENT_SECRET,

                code:
                  code,

                grant_type:
                  "authorization_code",

                redirect_uri:
                  REDIRECT_URI
              })
          }
        );

      const token =
        await tokenResponse.json();

      if (
        !tokenResponse.ok ||
        !token.access_token
      ) {

        return page(`
          <h1>TikTok Token Error</h1>

          <pre>${escapeHTML(
            JSON.stringify(
              token,
              null,
              2
            )
          )}</pre>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `, 500);
      }

      const accessToken =
        token.access_token;

      // GET PROFILE
      const profileResponse =
        await fetch(
          `${TIKTOK_API}/user/info/?fields=open_id,union_id,display_name,avatar_url,avatar_url_100,avatar_large_url`,
          {
            method: "GET",

            headers: {
              Authorization:
                `Bearer ${accessToken}`
            }
          }
        );

      const profile =
        await profileResponse.json();

      const user =
        profile.data?.user;

      if (!user) {

        return page(`
          <h1>TikTok Connected</h1>

          <p>
            Authorization succeeded, but no profile info was returned.
          </p>

          <a href="https://dev.vynttechnologies.workers.dev/">
            Return to VYNT
          </a>
        `);
      }

      // GET VIDEOS
      const videoFields = "id,title,video_description,cover_image_url,share_url,duration,create_time";

      const videosResponse =
        await fetch(
          `${TIKTOK_API}/video/list/?fields=${videoFields}`,
          {
            method: "POST",

            headers: {
              Authorization:
                `Bearer ${accessToken}`,

              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify({
                max_count: 10
              })
          }
        );

      const videosData =
        await videosResponse.json();

      const videos =
        videosData.data?.videos || [];

      // =========================================
      // PROCESS VIDEOS WITH WORKERS AI & D1
      // =========================================

      const optimizedVideos = await Promise.all(
        videos.map(video => processVideoSEO(env, user.open_id || "creator", video))
      );

      // RENDER AI DASHBOARD
      return page(`
        
        ${
          user.avatar_url
            ? `
              <img
                class="avatar"
                src="${escapeHTML(
                  user.avatar_url
                )}"
                alt="TikTok profile"
              >
            `
            : ""
        }

        <div class="success">
          ✓ VYNT Workers AI Active
        </div>

        <h1>
          ${escapeHTML(
            user.display_name ||
            "TikTok Creator"
          )}
        </h1>

        <p class="subtitle">
          AI-Powered TikTok SEO & Post Optimization
        </p>

        <div class="divider"></div>

        <h2>
          Post Optimization Reports
        </h2>

        <p class="muted">
          Analyzed ${optimizedVideos.length} post${
            optimizedVideos.length === 1
              ? ""
              : "s"
          } using Cloudflare Workers AI (Llama 3).
        </p>

        ${
          optimizedVideos.length
            ? `
              <div class="videos">

                ${optimizedVideos.map(item => `
                  
                  <div class="video">

                    ${
                      item.cover_image_url
                        ? `
                          <img
                            src="${escapeHTML(
                              item.cover_image_url
                            )}"
                            alt="Video thumbnail"
                            loading="lazy"
                          >
                        `
                        : ""
                    }

                    <div class="video-content">

                      <div class="seo-score">
                        SEO Score: <strong>${item.ai_seo.score}/100</strong>
                      </div>

                      <h3>
                        ${escapeHTML(
                          item.title ||
                          "Untitled Post"
                        )}
                      </h3>

                      ${
                        item.video_description
                          ? `
                            <p class="original-desc">
                              <strong>Original Caption:</strong> ${escapeHTML(
                                item.video_description
                              )}
                            </p>
                          `
                          : ""
                      }

                      <div class="ai-box">
                        <span class="ai-badge">VYNT AI Optimized Hook</span>
                        <p class="optimized-caption">${escapeHTML(item.ai_seo.optimizedCaption)}</p>
                      </div>

                      <div class="ai-box">
                        <span class="ai-badge">High-Ranking Hashtags</span>
                        <p class="hashtags">${escapeHTML(item.ai_seo.recommendedHashtags)}</p>
                      </div>

                      <div class="ai-box">
                        <span class="ai-badge">SEO Tip</span>
                        <p class="seo-tip">${escapeHTML(item.ai_seo.seoTip)}</p>
                      </div>

                      ${
                        item.share_url
                          ? `
                            <a
                              class="watch"
                              href="${escapeHTML(
                                item.share_url
                              )}"
                              target="_blank"
                              rel="noopener"
                            >
                              View on TikTok
                            </a>
                          `
                          : ""
                      }

                    </div>

                  </div>

                `).join("")}

              </div>
            `
            : `
              <div class="empty">

                <h3>
                  No videos returned
                </h3>

                <p>
                  Post public videos on TikTok to generate live AI SEO insights.
                </p>

              </div>
            `
        }

        <div class="divider"></div>

        <a
          class="return"
          href="https://dev.vynttechnologies.workers.dev/"
        >
          Return to VYNT Dashboard
        </a>

      `);
    }

    return new Response(
      "VYNT TikTok Worker is running."
    );
  }
};


// =============================================
// WORKERS AI & D1 LOGIC
// =============================================

async function processVideoSEO(env, openId, video) {
  
  // 1. Check D1 Database Cache
  if (env.DB) {
    try {
      const cached = await env.DB.prepare(
        "SELECT ai_caption, hashtags, seo_score FROM user_seo WHERE open_id = ? AND video_id = ?"
      ).bind(openId, video.id).first();

      if (cached) {
        return {
          ...video,
          ai_seo: {
            score: cached.seo_score,
            optimizedCaption: cached.ai_caption,
            recommendedHashtags: cached.hashtags,
            seoTip: "Loaded from cached D1 history."
          }
        };
      }
    } catch (e) {
      console.error("D1 Read Error:", e);
    }
  }

  // Fallback defaults
  let aiResult = {
    score: 80,
    optimizedCaption: "🔥 Stop scrolling! Here is the main insight you need for this video topic.",
    recommendedHashtags: "#TikTokSEO #FYP #TrendingTips #ContentStrategy",
    seoTip: "Speak your key topic within the first 3 seconds to trigger TikTok's auto-captioning indexing."
  };

  // 2. Call Cloudflare Workers AI (Llama 3)
  if (env.AI) {
    try {
      const prompt = `Analyze this TikTok post for SEO:
Title: "${video.title || ''}"
Description: "${video.video_description || ''}"

Output ONLY a raw, valid JSON object with no markdown styling:
{
  "score": 85,
  "optimizedCaption": "Optimized engaging hook and caption",
  "recommendedHashtags": "#tag1 #tag2 #tag3 #tag4 #tag5",
  "seoTip": "One clear action tip to boost algorithmic reach"
}`;

      const aiResponse = await env.AI.run('@cf/meta/llama-3-8b-instruct', {
        messages: [
          { role: 'system', content: 'You are an AI TikTok SEO strategist. Output strictly raw valid JSON.' },
          { role: 'user', content: prompt }
        ]
      });

      if (aiResponse && aiResponse.response) {
        const cleanedText = aiResponse.response.replace(/```json/g, '').replace(/```/g, '').trim();
        aiResult = JSON.parse(cleanedText);
      }
    } catch (err) {
      console.error("Workers AI Processing Error:", err);
    }
  }

  // 3. Save to D1 Database
  if (env.DB) {
    try {
      await env.DB.prepare(
        `INSERT INTO user_seo (open_id, access_token, video_id, title, ai_caption, hashtags, seo_score)
         VALUES (?, 'active', ?, ?, ?, ?, ?)
         ON CONFLICT(open_id) DO UPDATE SET
         ai_caption=excluded.ai_caption, hashtags=excluded.hashtags, seo_score=excluded.seo_score`
      ).bind(
        openId,
        video.id || "vid_1",
        video.title || "Untitled",
        aiResult.optimizedCaption,
        aiResult.recommendedHashtags,
        aiResult.score
      ).run();
    } catch (e) {
      console.error("D1 Write Error:", e);
    }
  }

  return {
    ...video,
    ai_seo: aiResult
  };
}


// =============================================
// COOKIE PARSER
// =============================================

function parseCookies(header) {
  const cookies = {};
  if (!header) return cookies;
  for (const part of header.split(";")) {
    const [key, ...value] = part.trim().split("=");
    if (key) cookies[key] = value.join("=");
  }
  return cookies;
}



{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "vynt-tiktok",

  "main": "src/index.js",

  "compatibility_date": "2026-09-20",

  "assets": {
    "directory": "./public",

    "run_worker_first": [
      "/oauth/*",
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vynt-tiktok",
      "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}
